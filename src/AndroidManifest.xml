<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.zuakeo.voicekey"
    android:versionCode="13"
    android:versionName="0.13">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />

    <!-- Android 11 的包可见性：不声明就 getPackageInfo("com.zuakeo.inknote") 会抛
         NameNotFoundException，拿不到便签的 uid，也就写不进它的私有收件箱。
         实测报错是「pushToInbox: 查不到便签的 uid」，录音只能回落公共目录。 -->
    <queries>
        <package android:name="com.zuakeo.inknote" />
    </queries>

    <application
        android:label="语音键"
        android:persistent="true"
        android:allowBackup="false"
        android:requestLegacyExternalStorage="true"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="语音键">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".WakeActivity"
            android:exported="false"
            android:theme="@style/WakeTheme"
            android:noHistory="true"
            android:excludeFromRecents="true"
            android:showWhenLocked="false"
            android:turnScreenOn="false"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <service
            android:name=".KeyService"
            android:exported="false"
            android:foregroundServiceType="microphone" />
    </application>
</manifest>
